#!/usr/bin/env bash
# Green = exit 0. Node ≥ 22 strips TS types natively; no build step.
cd "$(dirname "$0")" || exit 1
out=$(node --test --test-reporter=dot ./*.test.ts 2>&1); rc=$?
clk=$([ -x ./clock ] && ./clock)
if [ $rc -eq 0 ]; then echo "PASS${clk:+ · $clk}"; else echo "$out" | grep -m1 -E "not ok|Error|error" || echo "FAIL"; [ -n "$clk" ] && echo "$clk"; fi
exit $rc
