#!/usr/bin/env bash
# Everything the sensei needs at the top of a session. Run it first, in any harness.
h="${SENSEI_HOME:-$HOME/.sensei}"; here="$(cd "$(dirname "$0")" && pwd)"
echo "## Now"; date '+%F %H:%M (%a)'
if [ -f "$h/session.json" ]; then
  echo "## UNLOGGED SESSION — log it first (green:false, note: unlogged), delete session.json, then begin"
  cat "$h/session.json"; "$here/clock"
fi
echo "## Learner model"
[ -f "$h/learner.yaml" ] && cat "$h/learner.yaml" || echo "NO LEARNER MODEL — see First run."
echo "## Last 5 sessions"
[ -s "$h/log.jsonl" ] && tail -n 5 "$h/log.jsonl" || echo "(no sessions yet)"
echo "## Attendance"; "$here/streak"
echo "## Tracks on disk"
ls "$h/tracks/" 2>/dev/null || echo "(none — setup <track>)"
dojo=$(sed -n 's/^ *dojo: *\([^ #]*\).*/\1/p' "$h/learner.yaml" 2>/dev/null | head -1); dojo="${dojo/#\~/$HOME}"
if [ -n "$dojo" ] && [ -d "$dojo/.git" ]; then
  last=$(ls -d "$dojo"/katas/*/ 2>/dev/null | sort | tail -1)
  if [ -n "$last" ]; then
    echo "## Last kata — commits touching it (author · subject); anything agent-authored after setup is drift"
    git -C "$dojo" log --format='%an · %s' -- "${last#$dojo/}" 2>/dev/null | head -5
  fi
fi
exit 0
