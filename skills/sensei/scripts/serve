#!/usr/bin/env python3
"""Serve one sensei session page. Stdlib only, no dependencies, self-reaping.

  scripts/serve [--dojo <root>] [--port 3119] [--idle-timeout 900]

The page is static (assets/page.html) and never regenerated: the agent writes
.dojo/page.json, the page polls GET /state and redraws on a version bump.

Endpoints
  GET  /            the page shell
  GET  /state       .dojo/page.json verbatim
  GET  /lesson      the markdown named by state["lesson"] — must live under <dojo>/lessons/
  GET  /events      what the learner has committed this session (refresh-safe)
  POST /commit      append one learner action to .dojo/page-events.jsonl
  POST /file        write ONE path named in state["writable"] — nothing else
  POST /check       run exactly <kata_dir>/check, no arguments

/check takes no parameters, /lesson and /file take no path of their own
choosing; all targets come from page.json, which only the agent writes. That
is the whole surface of the 0.0.0.0 bind.
"""
import argparse, json, os, pathlib, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = pathlib.Path(__file__).resolve().parent
SHELL = HERE.parent / "assets" / "page.html"
MAX_BODY = 2 * 1024 * 1024


def find_dojo(start):
    p = pathlib.Path(start).resolve()
    for d in [p, *p.parents]:
        if (d / ".dojo").is_dir():
            return d
    return None


class State:
    """Everything mutable, guarded by one lock. Small enough not to need more."""

    def __init__(self, root, idle):
        self.root = root
        self.dojo = root / ".dojo"
        self.idle = idle
        self.touched = time.time()
        self.lock = threading.Lock()

    def touch(self):
        self.touched = time.time()

    def page(self):
        try:
            return json.loads((self.dojo / "page.json").read_text())
        except FileNotFoundError:
            return {"v": 0, "phase": "idle", "cards": [],
                    "headline": "No session open. Run /sensei start."}
        except json.JSONDecodeError as e:
            return {"v": 0, "phase": "error", "cards": [],
                    "headline": f"page.json is not valid JSON: {e}"}

    def events(self):
        f = self.dojo / "page-events.jsonl"
        if not f.exists():
            return []
        out = []
        for line in f.read_text().splitlines():
            line = line.strip()
            if line:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
        return out

    def commit(self, ev):
        ev = dict(ev)
        ev["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with self.lock:
            with open(self.dojo / "page-events.jsonl", "a") as fh:
                fh.write(json.dumps(ev, ensure_ascii=False) + "\n")
        return ev

    def resolve_writable(self, rel):
        """A path is writable only if page.json named it verbatim and it stays
        inside the dojo. Both conditions, every time — no path arithmetic from
        the browser is trusted."""
        allowed = self.page().get("writable") or []
        if rel not in allowed:
            return None
        target = (self.root / rel).resolve()
        try:
            target.relative_to(self.root)
        except ValueError:
            return None
        return target

    def lesson(self):
        """The lesson file is whatever page.json names, and only if it sits
        under <dojo>/lessons/. The browser never picks a path."""
        rel = self.page().get("lesson")
        if not isinstance(rel, str) or not rel:
            return {"path": None, "md": ""}
        target = (self.root / rel).resolve()
        try:
            target.relative_to((self.root / "lessons").resolve())
        except ValueError:
            return {"path": rel, "md": "", "error": "lesson path is not under lessons/"}
        try:
            return {"path": rel, "md": target.read_text()}
        except FileNotFoundError:
            return {"path": rel, "md": "", "error": "lesson file not found"}

    def kata_check(self):
        kd = self.page().get("kata_dir")
        if not kd:
            return 1, "no kata_dir in page.json"
        check = (self.root / kd / "check").resolve()
        try:
            check.relative_to(self.root)
        except ValueError:
            return 1, "kata_dir points outside the dojo"
        if not (check.is_file() and os.access(check, os.X_OK)):
            return 1, f"no executable check at {kd}/check"
        try:
            p = subprocess.run([str(check)], cwd=str(check.parent),
                               capture_output=True, text=True, timeout=60)
            return p.returncode, (p.stdout + p.stderr).strip()
        except subprocess.TimeoutExpired:
            return 1, "check timed out after 60s"


def handler(st):
    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json; charset=utf-8"):
            if isinstance(body, (dict, list)):
                body = json.dumps(body, ensure_ascii=False)
            raw = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)

        def _body(self):
            n = int(self.headers.get("Content-Length") or 0)
            if n <= 0 or n > MAX_BODY:
                return None
            try:
                return json.loads(self.rfile.read(n))
            except (json.JSONDecodeError, UnicodeDecodeError):
                return None

        def do_GET(self):
            st.touch()
            p = self.path.split("?")[0]
            if p in ("/", "/index.html"):
                try:
                    return self._send(200, SHELL.read_text(), "text/html; charset=utf-8")
                except FileNotFoundError:
                    return self._send(500, "page shell missing", "text/plain")
            if p == "/state":
                return self._send(200, st.page())
            if p == "/lesson":
                return self._send(200, st.lesson())
            if p == "/events":
                return self._send(200, st.events())
            return self._send(404, {"error": "no such path"})

        def do_POST(self):
            st.touch()
            p = self.path.split("?")[0]
            body = self._body()
            if body is None:
                return self._send(400, {"error": "body must be JSON under 2MB"})

            if p == "/commit":
                if not isinstance(body, dict) or "kind" not in body:
                    return self._send(400, {"error": "need an object with a kind"})
                return self._send(200, {"ok": True, "event": st.commit(body)})

            if p == "/file":
                rel, content = body.get("path"), body.get("content")
                if not isinstance(rel, str) or not isinstance(content, str):
                    return self._send(400, {"error": "need path and content strings"})
                target = st.resolve_writable(rel)
                if target is None:
                    return self._send(403, {"error": f"{rel} is not writable this session"})
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(content)
                return self._send(200, {"ok": True, "bytes": len(content.encode())})

            if p == "/check":
                rc, out = st.kata_check()
                st.commit({"kind": "check", "rc": rc})
                return self._send(200, {"rc": rc, "out": out, "green": rc == 0})

            return self._send(404, {"error": "no such path"})

    return H


def reaper(st, httpd):
    """A forgotten server is self-correcting: an open page polls, so the timer
    only runs down once nothing is holding the page open."""
    while True:
        time.sleep(5)
        if st.idle and time.time() - st.touched > st.idle:
            print("sensei serve: idle, exiting", file=sys.stderr)
            httpd.shutdown()
            return


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dojo", default=".")
    ap.add_argument("--port", type=int, default=3119)
    ap.add_argument("--idle-timeout", type=int, default=900,
                    help="seconds with no request before exiting; 0 disables")
    a = ap.parse_args()

    root = find_dojo(a.dojo)
    if root is None:
        print(f"no dojo at or above {a.dojo} (looked for a .dojo/ directory)", file=sys.stderr)
        return 1

    st = State(root, a.idle_timeout)
    httpd = ThreadingHTTPServer(("0.0.0.0", a.port), handler(st))
    threading.Thread(target=reaper, args=(st, httpd), daemon=True).start()
    print(f"sensei serve: {root} on :{a.port}", file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
