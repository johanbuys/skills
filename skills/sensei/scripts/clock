#!/usr/bin/env bash
# One line of session clock, or nothing when no session is open. Lives at <dojo>/.dojo/clock after init.
root=$("$(dirname "$0")/../scripts/dojo-root" 2>/dev/null || true)
[ -n "$root" ] || root=$(cd "$(dirname "$0")/.." && pwd)     # when running as <dojo>/.dojo/clock
s="$root/.dojo/session.json"; [ -f "$s" ] || exit 0
start=$(jq -r '.started_at // empty' "$s"); phase=$(jq -r '.phase // "?"' "$s")
[ -n "$start" ] || exit 0
now=$(date +%s)
st=$(date -d "$start" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "${start%%.*}" +%s 2>/dev/null \
  || python3 -c 'import sys,datetime;print(int(datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")).timestamp()))' "$start" 2>/dev/null || echo "$now")
min=$(( (now - st) / 60 ))
msg="SENSEI CLOCK: ${min}/20 min · phase: ${phase}"
[ "$min" -ge 15 ] && [ "$min" -lt 20 ] && msg="$msg · move to explain-back"
[ "$min" -ge 20 ] && msg="$msg · TIME IS UP — log it now (green:false if not green)"
echo "$msg"
